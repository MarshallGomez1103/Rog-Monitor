[Unit]
Description=ROG Monitor — Guardian Termico CPU/GPU (fans primero, potencia despues)
Documentation=https://github.com/rog-monitor/rog-monitor
After=multi-user.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
# El script es una copia root:root instalada por scripts/install-system.sh.
# NUNCA apuntar esto a un archivo del repo/home del usuario: corre como root.
ExecStart=/usr/bin/bash /usr/local/libexec/rog-monitor/rog-thermal-guardian.sh
# Techo configurable sin editar esta unidad: usar un override.conf
# en /etc/systemd/system/rog-thermal-guardian.service.d/override.conf
# con Environment="ROG_THERMAL_CPU_CEILING=92" y
# Environment="ROG_THERMAL_GPU_CEILING=83". La app escribe ese
# override.conf (via pkexec + rog-ctl.sh guardian) cuando el usuario cambia los techos
# desde el modal de Centro de Poder.
Environment="ROG_THERMAL_CPU_CEILING=92"
Environment="ROG_THERMAL_GPU_CEILING=83"
Environment="ROG_THERMAL_INTERVAL=2"
Environment="ROG_THERMAL_MODULATE_LOAD=0"
Environment="ROG_THERMAL_OVER_GRACE=12"
Environment="ROG_THERMAL_CUT_INTERVAL=10"
Environment="ROG_THERMAL_DB_STEP=2"
Environment="ROG_THERMAL_PL2_STEP=5"
Restart=on-failure
RestartSec=5
# Necesita escribir en sysfs (asus-armoury, platform_profile, throttle_thermal_policy)
# y leer temperatura via nvidia-smi: requiere root. NO ejecutar como usuario.
User=root
Group=root
# Endurecimiento conservador: no aislamos /sys porque el script necesita
# escribir varias rutas sysfs reales del firmware ASUS y NVIDIA.
NoNewPrivileges=true
# false: el script publica estado para la UI en
# ~/.local/share/rog-monitor/thermal-guardian-state.json (home del usuario).
# Con true/read-only systemd puede ocultar el home o bloquear ese archivo.
ProtectHome=false
ProtectSystem=false

[Install]
WantedBy=multi-user.target
